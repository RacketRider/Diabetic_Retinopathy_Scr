# Local datasets and split artifacts (never commit)
data/*
!data/README.md

# Model checkpoints (never commit)
models/*
!models/README.md

# Large MATLAB binaries; keep only lightweight research artifacts
*.mat
!artifacts/baselines/*.mat
!artifacts/logs/*.mat
!artifacts/results/*.mat

# MATLAB temporary files
*.asv
*.autosave
*~
*.bak

# Generated local test/lint output
.coverage/
reports/

# OS/editor noise
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
